{
  "manifest_version": 3,
  "name": "EcoVoice Extension",
  "version": "1.0.0",
  "description": "Voice-controlled browser automation powered by EcoVoice.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EcoVoice Extension"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ]
}
